# Copy this file to .env.local and fill in your own Supabase project's values.
# Get these from your Supabase project: Project Settings -> API.
# Never commit .env.local — it's already in .gitignore.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — server-only, bypasses RLS. Used for admin actions and the seed script.
# NEVER prefix this with NEXT_PUBLIC_ and never import it into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used only by scripts/seed.ts to talk to Postgres directly (optional convenience).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
